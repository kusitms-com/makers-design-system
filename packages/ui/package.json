{
  "name": "@kusitms.com/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./source.css": "./dist/source.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@kusitms.com/icons": "workspace:*",
    "@kusitms.com/tokens": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-select": "^2.2.5"
  },
  "devDependencies": {
    "@kusitms.com/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "^29.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsup": "8.5.1",
    "typescript": "6.0.2"
  },
  "scripts": {
    "build": "tsup && cp src/source.css dist/source.css",
    "check": "pnpm lint && pnpm typecheck",
    "lint": "biome check src tsup.config.ts vitest.config.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json"
  }
}
